# Copy to .env.local. Never commit real credentials.
APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL; not used by the initial mock-data dashboard yet.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omni_drive

# Configure only when Google OAuth is implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Configure when the server-side session implementation is added.
AUTH_SECRET=

# Configure only with a reviewed token-encryption implementation.
# Keep the encryption key separate from the database.
TOKEN_ENCRYPTION_KEY=